# Entorno: development | test | production
RACK_ENV=development

# Puma (D20)
PORT=9292
PUMA_MAX_THREADS=3
WEB_CONCURRENCY=0

# Postgres (docker compose)
POSTGRES_USER=fudo
POSTGRES_PASSWORD=

# Logging (D33): debug | info | warn | error
LOG_LEVEL=info

DATABASE_URL=postgres://fudo:CAMBIAR@localhost:5432/fudo_development
DB_POOL=5
