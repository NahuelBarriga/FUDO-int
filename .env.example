# Entorno: development | test | production
RACK_ENV=development

# Puma (D20)
PORT=9292
PUMA_MAX_THREADS=3
WEB_CONCURRENCY=0

# Postgres (container de docker compose). Solo letras y números.
POSTGRES_USER=fudo
POSTGRES_PASSWORD=
# Segundos para darse por vencido al conectar a Postgres
DB_CONNECT_TIMEOUT=2

# Base de datos para desarrollo local. La contraseña tiene que ser la misma que POSTGRES_PASSWORD.
# En Docker no se usa: el compose la reemplaza con el host "postgres".
# Para tests: crear .env.test con DATABASE_URL apuntando a fudo_test y BCRYPT_COST=4.
DATABASE_URL=postgres://fudo:CAMBIAR@localhost:5432/fudo_development
DB_POOL=5

# JWT. Obligatorio, al menos 32 bytes. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=3600

# bcrypt: 12 por defecto (cada +1 duplica el tiempo de hash)
BCRYPT_COST=12

# Redis / Sidekiq. En Docker el compose usa el host "redis".
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_POLL_INTERVAL=1

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting (D56). Store: redis | memory (memory solo para tests).
RATE_LIMIT_STORE=redis
RATE_LIMIT_GENERAL=300
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_USERNAME=5
RATE_LIMIT_REGISTER_IP=10
